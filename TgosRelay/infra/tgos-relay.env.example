# 複製成 /etc/tgos-relay.env，chmod 600，root 擁有。改完 systemctl restart tgos-relay。
RELAY_KEY=請填32字以上隨機字串_與YYAPI的TGOS_RELAY_KEY相同

# ── 正查（/geocode）：TGOS「地址查詢坐標服務」的金鑰 ──────────────────────────
TGOS_APPID=
TGOS_APIKEY=
# 實測發現 X 是緯度時改 true
TGOS_XY_SWAP=false

# ── 反查（/reverse）：TGOS「坐標回傳門牌服務」的金鑰 ─────────────────────────
# ⚠️ 這是**另一支服務、要另外申請**，與上面那組不是同一組金鑰，也不可互相共用。
#    一支已核准、另一支還沒，是正常狀態：/healthz 的 tgosConfigured 與 geoConfigured 分開報。
#    拿錯金鑰打過去只會回一句純文字 "Length of the data to decrypt is invalid."（沒有明確錯誤碼）。
TGOS_GEO_APPID=
TGOS_GEO_APIKEY=
# 反查的 X/Y 對調旗標，與正查的 TGOS_XY_SWAP 各自獨立（不同服務、不同端點）。
# 預設 false＝oPX 送經度、oPY 送緯度（EPSG:4326 的定義）；核准前未實測，
# 拿到金鑰後先打一筆台北的座標看回來的地址對不對（經度≈121、緯度≈25，弄反一眼就看得出來）。
TGOS_GEO_XY_SWAP=false
# 反查端點；預設 https://addr.tgos.tw/addrws/v40/GeoQueryAddr.asmx/PointQueryNearAddr（點查最近門牌）。
# 同服務另有 PointQueryAddr（多 oBuffer 公尺參數）／PointQueryNearAddrByBuffer／LineQueryAddr／PolygonQueryAddr。
# TGOS_GEO_URL=

# 反查地址是否含里／鄰。false＝從 FULL_ADDR 移除 VILLAGE／NEIGHBORHOOD 兩段（不自己重組地址）。
# 這是產品口徑（2026-09-09 使用者裁決），不是實測值；之後要含里鄰改 true 即可，不必改程式碼。
# 改了要 systemctl restart tgos-relay。
TGOS_GEO_INCLUDE_VILLAGE=false
# 反查結果距查詢點超過這個公尺數視同查無（/reverse 回 {found:false, tooFar:true, distanceM}）。
# TGOS 反查回的是「最近門牌」、沒有距離上限，工地空曠時可能回幾公里外的門牌卻照樣標成門牌精度。
# 這也是產品口徑（2026-09-09 使用者裁決）；0＝不限制。改了要 systemctl restart tgos-relay。
TGOS_GEO_MAX_DIST_M=200

# 兩支查詢共用這個間隔（同一個 TGOS 帳號，兩支加起來才是 1 req/s）
TGOS_MIN_INTERVAL_MS=1000
