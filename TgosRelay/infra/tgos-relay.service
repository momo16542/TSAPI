[Unit]
Description=TGOS geocode relay (TsERP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tgosrelay
WorkingDirectory=/opt/tgos-relay
ExecStart=/opt/tgos-relay/tgos-relay
EnvironmentFile=/etc/tgos-relay.env
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
