<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BotRateJob</RootNamespace>
    <AssemblyName>BotRateJob</AssemblyName>
    <!-- 需要中文與 zh-TW 文化，不能開 InvariantGlobalization -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.8.0" />
    <PackageReference Include="csvhelper" Version="30.0.1" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.0" />
    <!-- Cosmos SDK 的序列化器需要，未明確引用會建置失敗 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
  </ItemGroup>
</Project>
